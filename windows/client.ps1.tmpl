# voxbridge in-guest type client (non-admin, no install).
#
# Rendered and served by the host daemon at http://{{HOST_IP}}:{{HTTP_PORT}}/client.ps1
# Dials the host, authenticates with the shared token, then types each received
# utterance into the FOREGROUND window via SendInput (Unicode) -- whatever is
# focused in the VM receives it. Also syncs the text clipboard both ways when the
# host enables it. Auto-reconnects forever.

$ErrorActionPreference = "Stop"
$HostIP = "{{HOST_IP}}"
$Port   = {{TCP_PORT}}
$Token  = "{{TOKEN}}"
$Delay  = {{DELAY}}

# One client per session: the host keeps only the newest connection, so a second
# client would keep kicking the first off (and vice versa) every reconnect.
$script:Mutex = New-Object System.Threading.Mutex($false, 'Local\voxbridge-client')
if (-not $script:Mutex.WaitOne(0)) { exit }

Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class Inj {
    [StructLayout(LayoutKind.Sequential)]
    public struct MOUSEINPUT { public int dx; public int dy; public uint mouseData; public uint dwFlags; public uint time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)]
    public struct KEYBDINPUT { public ushort wVk; public ushort wScan; public uint dwFlags; public uint time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)]
    public struct HARDWAREINPUT { public uint uMsg; public ushort wParamL; public ushort wParamH; }
    [StructLayout(LayoutKind.Explicit)]
    public struct INPUTUNION {
        [FieldOffset(0)] public MOUSEINPUT mi;
        [FieldOffset(0)] public KEYBDINPUT ki;
        [FieldOffset(0)] public HARDWAREINPUT hi;
    }
    [StructLayout(LayoutKind.Sequential)]
    public struct INPUT { public uint type; public INPUTUNION u; }

    [DllImport("user32.dll", SetLastError=true)]
    public static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);

    [DllImport("user32.dll")]
    public static extern uint GetClipboardSequenceNumber();

    [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr hWnd, IntPtr pid);
    [DllImport("kernel32.dll")] static extern uint GetCurrentThreadId();
    [DllImport("user32.dll")] static extern bool AttachThreadInput(uint idAttach, uint idAttachTo, bool fAttach);
    [DllImport("user32.dll")] static extern short GetKeyState(int nVirtKey);

    public const uint INPUT_KEYBOARD = 1;
    public const uint KEYEVENTF_KEYUP = 0x0002;
    public const uint KEYEVENTF_UNICODE = 0x0004;
    const ushort VK_SENTINEL = 0xE8;  // unassigned; AutoHotkey uses it as a no-op key too
    static int SZ = Marshal.SizeOf(typeof(INPUT));

    static void Key(INPUT[] inp, int i, ushort vk, ushort scan, uint flags) {
        inp[i].type = INPUT_KEYBOARD; inp[i].u.ki.wVk = vk; inp[i].u.ki.wScan = scan; inp[i].u.ki.dwFlags = flags;
    }

    // Apps like the WinUI Notepad dequeue VK_PACKET key-downs before translating
    // them, so a packet sent before the previous one is translated overwrites it
    // ("new" -> "www"). With our input state attached to the foreground thread,
    // GetKeyState reflects what that thread has read: follow each character with a
    // sentinel key and wait until its key-up has been read before the next one.
    public static void TypeUnicode(string s, int perCharDelayMs) {
        uint me = GetCurrentThreadId();
        uint target = GetWindowThreadProcessId(GetForegroundWindow(), IntPtr.Zero);
        // fails for elevated windows (UIPI), where SendInput is blocked anyway
        bool paced = target != 0 && target != me && AttachThreadInput(me, target, true);
        try {
            foreach (char c in s) {
                INPUT[] inp = new INPUT[paced ? 4 : 2];
                Key(inp, 0, 0, (ushort)c, KEYEVENTF_UNICODE);
                Key(inp, 1, 0, (ushort)c, KEYEVENTF_UNICODE | KEYEVENTF_KEYUP);
                if (paced) {
                    Key(inp, 2, VK_SENTINEL, 0, 0);
                    Key(inp, 3, VK_SENTINEL, 0, KEYEVENTF_KEYUP);
                }
                int toggled = GetKeyState(VK_SENTINEL) & 1;
                SendInput((uint)inp.Length, inp, SZ);
                if (paced) {
                    // read = toggle bit flipped by the key-down, high bit cleared by the key-up
                    var deadline = DateTime.UtcNow.AddSeconds(2);
                    bool read = false;
                    while (!read && DateTime.UtcNow < deadline) {
                        short st = GetKeyState(VK_SENTINEL);
                        read = (st & 1) != toggled && (st & 0x8000) == 0;
                        if (!read) System.Threading.Thread.Sleep(1);
                    }
                    if (!read) {
                        // target hung: don't stall 2s per character, finish unpaced
                        AttachThreadInput(me, target, false);
                        paced = false;
                    }
                }
                if (perCharDelayMs > 0) System.Threading.Thread.Sleep(perCharDelayMs);
            }
        } finally {
            if (paced) AttachThreadInput(me, target, false);
        }
    }
}
"@

Add-Type -AssemblyName System.Windows.Forms   # Clipboard; powershell.exe is STA
$ClipMax  = 1MB
# Last clipboard text synced either way (LF line endings). Setting the clipboard
# bumps the sequence number too, so without this every sync would echo back.
$LastClip = $null

while ($true) {
    $client = $null
    try {
        $client = New-Object System.Net.Sockets.TcpClient
        $client.Connect($HostIP, $Port)
        $stream = $client.GetStream()
        $reader = New-Object System.IO.StreamReader($stream, [System.Text.Encoding]::ASCII)
        $writer = New-Object System.IO.StreamWriter($stream, [System.Text.Encoding]::ASCII)
        $writer.NewLine = "`n"; $writer.AutoFlush = $true
        $writer.WriteLine($Token)                 # authenticate
        $hello = "$($reader.ReadLine())" -split ' '   # "<delay ms> <clipboard 0|1>"
        if ($hello[0] -match '^\d+$') { $Delay = [int]$hello[0] }
        $ClipSync = $hello.Count -gt 1 -and $hello[1] -eq '1'
        $seq = [Inj]::GetClipboardSequenceNumber()
        $pending = $reader.ReadLineAsync()
        while ($true) {
            # wait briefly for the host so the clipboard poll below keeps running
            if ($pending.Wait(250)) {
                $line = $pending.Result
                if ($null -eq $line) { break }     # host closed / disconnected
                $pending = $reader.ReadLineAsync()
                $kind, $b64 = $line -split ' ', 2
                if (-not $b64) { continue }
                $text = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b64))
                if ($kind -eq 'T') {
                    [Inj]::TypeUnicode($text, $Delay)
                } elseif ($kind -eq 'C') {
                    $LastClip = $text
                    try {
                        [System.Windows.Forms.Clipboard]::SetDataObject($text.Replace("`n", "`r`n"), $true, 10, 50)
                    } catch { }                    # held open by another app past the retries
                }
            }
            if (-not $ClipSync) { continue }
            $now = [Inj]::GetClipboardSequenceNumber()
            if ($now -eq $seq) { continue }
            $seq = $now
            $text = $null
            try {
                if ([System.Windows.Forms.Clipboard]::ContainsText()) {
                    $text = [System.Windows.Forms.Clipboard]::GetText().Replace("`r`n", "`n")
                }
            } catch { }                            # clipboard busy; next change retries
            if (-not $text -or $text -ceq $LastClip) { continue }
            $bytes = [System.Text.Encoding]::UTF8.GetBytes($text)
            if ($bytes.Length -gt $ClipMax) { continue }
            $LastClip = $text
            $writer.WriteLine('C ' + [System.Convert]::ToBase64String($bytes))
        }
    } catch {
        # swallow and reconnect
    } finally {
        if ($client) { $client.Close() }
    }
    Start-Sleep -Seconds 2                          # reconnect backoff
}
